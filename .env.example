# Copy this file to .env and fill in the values you have.

# --- RailRadar (real trains, live running status, station boards, coach composition) ---
# Free key: https://railradar.in/developers
VITE_RAILRADAR_API_KEY=your_key_here
VITE_RAILRADAR_API_BASE=https://api.railradar.in/v1

# --- Real IRCTC fares and seat availability (optional) ---
# Free key: https://irctc.dev/dashboard (10,000 sandbox calls included)
# When set, the app shows live IRCTC fares and availability instead of simulations.
# IRCTC_API_KEY=your_irctc_api_key
# IRCTC_API_BASE=https://api.irctc.dev

# --- Email delivery (optional) ---
# Option A: any SMTP server. For Gmail use an App Password, not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_16_char_app_password
# MAIL_FROM=Rail Bandhu <you@gmail.com>

# Option B: EmailJS (create a service + template with {{message_html}} and {{subject}}).
# EMAILJS_SERVICE_ID=service_xxx
# EMAILJS_TEMPLATE_ID=template_xxx
# EMAILJS_PUBLIC_KEY=your_public_key
# EMAILJS_PRIVATE_KEY=your_private_key

# When no SMTP/EmailJS is configured, the backend uses an Ethereal test inbox and
# returns a preview URL, so the full email flow can still be demonstrated.
# EMAIL_TEST_MODE=true
